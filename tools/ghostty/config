# Open every window at a readable size. Ghostty's macOS default of 13 lands a
# few Cmd-+ steps short, and those steps do not persist, so each new window
# starts with the same ritual.
font-size = 18

# Size new windows at open. The option+i toggle shows and hides Ghostty rather
# than launching it fresh, so this is what every session lands in. Values:
#   non-native              -- Fill the screen with no animation and hide the
#                              menu bar. Snappiest for a show/hide hotkey, but
#                              breaks macOS native tabs.
#   non-native-visible-menu -- Fill the screen with no animation and keep the
#                              menu bar visible.
#   non-native-padded-notch -- Fill the screen with no animation, hide the menu
#                              bar, and pad the window clear of the notch.
#   true                    -- Enter native macOS fullscreen. Keeps tabs
#                              working, but animates into and out of its own
#                              Space on every hide and show.
#   false                   -- Open windows at Ghostty's default size.
fullscreen = non-native

# Hide the titlebar so a fullscreen window is one uninterrupted text grid with
# no chrome band above it. Switch back to "transparent" if windowed mode gets
# use: a hidden titlebar leaves no strip to drag the window by.
macos-titlebar-style = hidden

# Suppress the pane-size overlay that appears while resizing a split. It is a
# transient box surfacing in the periphery, the exact interruption a fullscreen
# terminal is meant to remove.
resize-overlay = never

# Hide the pointer while typing. A parked mouse cursor is one more object in the
# field that twitches on every trackpad brush.
mouse-hide-while-typing = true

# Tint the inactive split rather than only fading it. Ghostty paints a
# rectangle over every unfocused split, taking its alpha from the opacity below
# and its color from the fill, which defaults to the background and so only
# darkens. A hue shift marks a pane inactive without reading as disabled, which
# is how the stock 0.7 fade came across.
unfocused-split-opacity = 0.85
unfocused-split-fill = #6a5acd

# Even out every pane after a split. Ghostty lays splits out as a binary tree,
# so a split halves only the focused pane and a third one leaves the first pane
# twice the width of the other two; equalizing restores the even row editors
# like VS Code give by default. The chain keyword appends an action to the
# keybind above it and needs Ghostty 1.3.0 or newer.
keybind = super+d=new_split:right
keybind = chain=equalize_splits
keybind = super+shift+d=new_split:down
keybind = chain=equalize_splits

# Even out the panes that survive a ctrl+d close too. Ctrl+d is the shell's
# end-of-file rather than a Ghostty keybind, so no close action exists to chain
# onto; unconsumed still passes the key through to the shell and runs the
# equalize alongside it.
#
# TODO: Drop this line if the equalize lands before the pane finishes closing,
# or if re-equalizing on every other ctrl+d (vim's half-page scroll, less, a
# Python prompt) proves more annoying than the uneven row it fixes.
keybind = unconsumed:ctrl+d=equalize_splits

# Pad the grid off the window edges so text does not run into the frame.
window-padding-x = 8
window-padding-y = 8

# Spread leftover pixels across both edges instead of banking them on one side,
# keeping the text block centered as the window resizes.
window-padding-balance = true

# TODO: Set split-divider-color once a theme is picked. Left unset, Ghostty
# derives the divider from the active theme; a hardcoded gray here would have to
# be kept in sync with whatever background that theme sets.
