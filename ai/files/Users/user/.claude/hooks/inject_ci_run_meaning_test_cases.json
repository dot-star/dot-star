[
  {
    "expected": "inject",
    "name": "bare run link",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567"
  },
  {
    "expected": "inject",
    "name": "bare job link copied with its PR query",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567/job/7654321?pr=12"
  },
  {
    "expected": "inject",
    "name": "bare run link with surrounding whitespace",
    "prompt": "  https://github.com/foo/bar/actions/runs/1234567\n"
  },
  {
    "expected": "inject",
    "name": "bare run link to a retry attempt",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567/attempts/2"
  },
  {
    "expected": "inject",
    "name": "bare job link to a log line",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567/job/7654321#step:4:12"
  },
  {
    "expected": "pass-through",
    "name": "run link after typed words",
    "prompt": "why did this fail? https://github.com/foo/bar/actions/runs/1234567"
  },
  {
    "expected": "pass-through",
    "name": "run link before typed words",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567 only the lint job matters"
  },
  {
    "expected": "pass-through",
    "name": "run link with typed words on the next line",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567\nwhy did this fail?"
  },
  {
    "expected": "pass-through",
    "name": "run id running into other characters",
    "prompt": "https://github.com/foo/bar/actions/runs/1234567x"
  },
  {
    "expected": "pass-through",
    "name": "link to the Actions tab with no run",
    "prompt": "https://github.com/foo/bar/actions"
  },
  {
    "expected": "pass-through",
    "name": "plain prompt",
    "prompt": "fix the upload retry"
  }
